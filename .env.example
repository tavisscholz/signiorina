# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Payments (Stripe) -------------------------------------------------------
# With both keys set, checkout uses the Stripe Payment Element (cards, Apple Pay, Google Pay).
# Without them, development builds use a clearly labelled "payment not collected" test mode,
# and production builds stop before payment.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Allow the no-payment test mode in a production build (staging only — never on the live site)
ALLOW_DEV_ORDERS=false

# --- Operations ----------------------------------------------------------------
# Demo calendar data (a booked Saturday, a sold-out window, an event-blocked window).
# On by default in development, off in production.
DEMO_OPERATIONS=

# Show placeholder testimonials / founder story with "placeholder" labels.
# On by default in development, off in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# Where the JSON order/inquiry store writes (local/single-server only — see README)
DATA_DIR=

# Optional: POST each new event inquiry to this URL (CRM, Zapier, Make, email relay…)
INQUIRY_WEBHOOK_URL=
